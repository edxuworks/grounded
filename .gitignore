# Prisma
packages/db/src/generated/

# Compiled output must never live in src/ — TypeScript builds to dist/.
# (Stale in-src .js/.d.ts artifacts shadow the .ts sources and break tooling.)
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# Testing
coverage

# Vite
*.local

# TypeScript
*.tsbuildinfo

# Vercel serverless bundle output (build artifact)
dist-vercel
