# ============================================================
# Grounded API — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# Node environment: development | test | production
NODE_ENV=development

# Port the Express server listens on.
PORT=3001

# ── Database ────────────────────────────────────────────────
# Supabase provides two connection strings:
#   DATABASE_URL       — the connection pooler URL (use for app queries)
#   DATABASE_DIRECT_URL — direct connection (use for Prisma migrations only)
#
# Find both in Supabase → Project Settings → Database → Connection string
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# ── Supabase Auth ────────────────────────────────────────────
# Found in Supabase → Project Settings → API
SUPABASE_URL="https://[project-ref].supabase.co"
# The anon key is safe to use server-side for auth.getUser() verification.
SUPABASE_ANON_KEY="eyJ..."
# Service role key — has full database access, bypasses RLS.
# Used for admin operations only (e.g. creating a user record after signup).
# KEEP THIS SECRET. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ── Mapbox ───────────────────────────────────────────────────
# Secret access token for server-side Mapbox Tilequery API calls.
# We proxy Mapbox requests through the API to keep this token secret.
# The public token used in the browser is in apps/web/.env
MAPBOX_SECRET_TOKEN="sk.eyJ..."

# ── Anthropic ────────────────────────────────────────────────
# API key for Claude — used to extract property addresses from uploaded OMs.
# Get yours at: https://console.anthropic.com → API Keys
# KEEP THIS SECRET. Never expose to the client.
ANTHROPIC_API_KEY="sk-ant-..."

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production: https://app.grounded.io
# In development: http://localhost:5173
ALLOWED_ORIGINS="http://localhost:5173"

# ── UK data-source API keys ──────────────────────────────────
# Each powers a location-intelligence router. All are optional — a router whose
# key is missing degrades gracefully (returns empty data) rather than erroring.
# Free registration links are in each provider's developer portal.

# EPC (Energy Performance Certificates) — HTTP Basic auth (email + key).
# Register: https://epc.opendatacommunities.org/login
EPC_API_EMAIL=""
EPC_API_KEY=""

# Ofcom broadband coverage/speeds. Register: https://api.ofcom.org.uk
OFCOM_API_KEY=""

# Companies House — corporate ownership profiles.
# Register: https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=""

# Transport for London — journey times. Register: https://api-portal.tfl.gov.uk
TFL_API_KEY=""

# ── Dev convenience ──────────────────────────────────────────
# When "true", the API injects the first DB user as the authenticated user,
# bypassing Supabase JWT verification. DEVELOPMENT ONLY — never set in production.
DEV_BYPASS_AUTH="false"
